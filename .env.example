# Copia a .env o define estas variables en el entorno de PHP/Apache.
# PHP no lee este archivo. En XAMPP las bases van en local-config.php (git lo ignora).
# En Hostinger van como SetEnv en el .htaccess del servidor. No subas ese .htaccess
# ni local-config.php dentro de un zip de actualización.
# No subas .env con contraseñas reales.

ADARA_DB_HOST=127.0.0.1
ADARA_DB_PORT=3306
ADARA_DB_NAME=adara
ADARA_DB_USER=root
ADARA_DB_PASS=
ADARA_DEBUG=0

# Panel de soporte. Vacío = el sitio sigue siendo de una sola empresa.
# En Hostinger el usuario de la base maestra no es el de la empresa.
ADARA_MASTER_DB_NAME=
ADARA_MASTER_DB_USER=
ADARA_MASTER_DB_PASS=

# Correo. El proyecto no lee este archivo: en Apache van como SetEnv en el .htaccess de la raíz.
# Puerto 465 usa SSL (smtps). Puerto 587 usa TLS. La clave real no se guarda en git.
ADARA_MAIL_HOST=smtp.hostinger.com
ADARA_MAIL_PORT=465
ADARA_MAIL_ENCRYPTION=ssl
ADARA_MAIL_USER=notificaciones@adarasystem.online
ADARA_MAIL_PASS=
ADARA_MAIL_FROM=notificaciones@adarasystem.online
ADARA_MAIL_FROM_NAME=ADARA ERP
ADARA_APP_URL=https://adarasystem.online/
